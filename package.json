{
  "name": "otelscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "otelscope: a VitePress site to explore the OTEL logs of your AI coding tools, one tab per tool",
  "scripts": {
    "data": "node scripts/prepare-data.mjs",
    "dev": "node scripts/prepare-data.mjs && vitepress dev docs --host 127.0.0.1",
    "build": "node scripts/prepare-data.mjs && vitepress build docs",
    "test": "node --test \"tests/*.test.js\" && vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.1",
    "echarts": "6.1.0",
    "happy-dom": "21.0.1",
    "vitepress": "1.6.4",
    "vitest": "3.2.7",
    "vue": "3.5.44"
  }
}
